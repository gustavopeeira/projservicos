function criarAgendamento(d){if(!d||!d.CLIENTE_ID||!Array.isArray(d.ITENS)||!d.ITENS.length)throw Error('Cliente e serviços obrigatórios.');const a=new Date(d.INICIO);if(isNaN(a))throw Error('Data inválida.');const mins=d.ITENS.reduce((s,i)=>{const n=+i.DURACAO_MINUTOS;if(!isFinite(n)||n<=0)throw Error('Duração inválida.');return s+n;},0);const r={ID:id_('AGD'),CLIENTE_ID:d.CLIENTE_ID,INICIO:a,FIM:new Date(+a+mins*60000),STATUS:'AGUARDANDO_APROVACAO',RECORRENCIA_ID:d.RECORRENCIA_ID||'',RECORRENCIA_TIPO:d.RECORRENCIA_TIPO||'',OBSERVACOES:d.OBSERVACOES||'',CRIADO_POR:d.CRIADO_POR||'',CRIADO_EM:new Date(),ATUALIZADO_EM:new Date()};sheet_('AGENDAMENTOS').appendRow(SHEET_SCHEMAS.AGENDAMENTOS.map(k=>r[k]??''));d.ITENS.forEach((i,n)=>{const x={ID:id_('ITA'),AGENDAMENTO_ID:r.ID,SERVICO_ID:i.SERVICO_ID||'',FUNCIONARIO_ID:i.FUNCIONARIO_ID||'',DURACAO_MINUTOS:+i.DURACAO_MINUTOS,PRECO_BASE:+(i.PRECO_BASE||0),DESCONTO_TIPO:i.DESCONTO_TIPO||'',DESCONTO_VALOR:+(i.DESCONTO_VALOR||0),PRECO_FINAL:+(i.PRECO_FINAL??i.PRECO_BASE??0),ORDEM:n+1};sheet_('ITENS_AGENDAMENTO').appendRow(SHEET_SCHEMAS.ITENS_AGENDAMENTO.map(k=>x[k]??''));});return{id:r.ID,status:r.STATUS,fim:r.FIM};}