function listarClientes(){return records_('CLIENTES').filter(r=>String(r.ATIVO).toUpperCase()!=='FALSE');} function salvarCliente(d){if(!d||!String(d.NOME||'').trim())throw Error('Informe o nome.');const t=String(d.TELEFONE||'').replace(/\\D/g,'');const old=t&&records_('CLIENTES').find(r=>String(r.TELEFONE||'').replace(/\\D/g,'')===t);if(old)return{id:old.ID,existente:true};const r={ID:id_('CLI'),NOME:String(d.NOME).trim(),TELEFONE:t,EMAIL:d.EMAIL||'',CRIADO_EM:new Date(),ATIVO:true,OBSERVACOES:d.OBSERVACOES||''};sheet_('CLIENTES').appendRow(SHEET_SCHEMAS.CLIENTES.map(k=>r[k]??''));return{id:r.ID};}