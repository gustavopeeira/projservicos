function listarServicos(){return records_('SERVICOS').filter(r=>String(r.ATIVO).toUpperCase()!=='FALSE');} function salvarServico(d){if(!d||!String(d.NOME||'').trim())throw Error('Informe o nome.');const r={ID:id_('SRV'),CATEGORIA_ID:d.CATEGORIA_ID||'',NOME:String(d.NOME).trim(),DESCRICAO:d.DESCRICAO||'',ATIVO:true};sheet_('SERVICOS').appendRow(SHEET_SCHEMAS.SERVICOS.map(k=>r[k]??''));return{id:r.ID};} function vincularServicoFuncionario(f,s,p){if(!f||!s||!isFinite(+p)||+p<0)throw Error('Dados inválidos.');const r={ID:id_('FSE'),FUNCIONARIO_ID:f,SERVICO_ID:s,PRECO:+p,ATIVO:true};sheet_('FUNCIONARIO_SERVICOS').appendRow(SHEET_SCHEMAS.FUNCIONARIO_SERVICOS.map(k=>r[k]??''));return{id:r.ID};}