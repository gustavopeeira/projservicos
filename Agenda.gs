function consultarAgenda(inicio,fim,funcId){const a=new Date(inicio),b=new Date(fim);if(isNaN(a)||isNaN(b)||b<=a)throw Error('Período inválido.');const rows=records_('AGENDAMENTOS').filter(r=>new Date(r.INICIO)>=a&&new Date(r.INICIO)<b);if(!funcId)return rows;const ids=records_('ITENS_AGENDAMENTO').filter(i=>String(i.FUNCIONARIO_ID)===String(funcId)).map(i=>String(i.AGENDAMENTO_ID));return rows.filter(r=>ids.includes(String(r.ID)));}