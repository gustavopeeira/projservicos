function consultarAgenda(inicio,fim,funcId,token){const u=exigirPerfil_(['ADMINISTRADOR','FUNCIONARIO','CLIENTE'],token);const a=new Date(inicio),b=new Date(fim);if(isNaN(a)||isNaN(b)||b<=a)throw Error('Período inválido.');let rows=records_('AGENDAMENTOS').filter(r=>new Date(r.INICIO)>=a&&new Date(r.INICIO)<b);if(u.PERFIL==='CLIENTE')rows=rows.filter(r=>String(r.CLIENTE_ID)===String(u.REFERENCIA_ID));if(u.PERFIL==='FUNCIONARIO'){const ids=records_('ITENS_AGENDAMENTO').filter(i=>String(i.FUNCIONARIO_ID)===String(u.REFERENCIA_ID)).map(i=>String(i.AGENDAMENTO_ID));rows=rows.filter(r=>ids.includes(String(r.ID)));}if(funcId&&u.PERFIL==='ADMINISTRADOR'){const ids=records_('ITENS_AGENDAMENTO').filter(i=>String(i.FUNCIONARIO_ID)===String(funcId)).map(i=>String(i.AGENDAMENTO_ID));rows=rows.filter(r=>ids.includes(String(r.ID)));}return rows;}